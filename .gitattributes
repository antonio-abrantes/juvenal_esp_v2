# Normalizar texto para evitar diferencias CRLF entre Windows e Linux
* text=auto
*.md text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ps1 text eol=crlf
*.tflite binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
